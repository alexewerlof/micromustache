{
    "name": "micromustache",
    "version": "8.0.3",
    "description": "A fast, minimal and secure template engine for JavaScript",
    "keywords": [
        "template",
        "mustache",
        "string processing",
        "string interpolation",
        "template engine",
        "lodash get",
        "lodash toPath",
        "lodash template",
        "microlibrary"
    ],
    "type": "module",
    "exports": {
        "import": "./lib/index.js",
        "types": "./lib/index.d.ts"
    },
    "directories": {
        "lib": "lib",
        "doc": "doc",
        "test": "test",
        "example": "examples"
    },
    "files": [
        "lib"
    ],
    "scripts": {
        "doc": "typedoc src/index.ts",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "fmt": "prettier --write .",
        "test": "npm run typecheck && node --import tsx --test",
        "test:watch": "npm run typecheck && node --import tsx --test --watch",
        "test:coverage": "npm run typecheck && node --import tsx --test --experimental-test-coverage",
        "test:examples": "npm run build && for i in examples/*.js;do echo \"$i\" && node \"$i\";done",
        "perf": "npm run build && node --cpu-prof perf/against-mustache.js",
        "preversion": "npm t",
        "prepublishOnly": "npm run build",
        "postversion": "git push && git push --tags"
    },
    "repository": {
        "type": "git",
        "url": "http://github.com/alexewerlof/micromustache.git"
    },
    "author": "Alex Ewerlöf",
    "license": "MIT",
    "devDependencies": {
        "@types/mustache": "^4.2.6",
        "@types/node": "^24.7.2",
        "mustache": "^4.2.0",
        "prettier": "^3.6.2",
        "tsx": "^4.20.6",
        "typedoc": "^0.28.14",
        "typescript": "^5.9.3"
    }
}
